# ============================================================
# JAS — Environment variables
# Copy to .env.local for local development.
# NEVER commit real credentials. Service-role / secret keys
# must NEVER be exposed in client-side code.
# ============================================================

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Bypasses Row Level Security — keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Paystack (Settings -> API Keys & Webhooks) ---
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# --- Resend (transactional email) ---
RESEND_API_KEY=re_xxxxxxxxxxxx
ORDER_NOTIFICATION_EMAIL=orders@yourdomain.com

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=233500000000
